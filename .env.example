# .env.example
# Example environment variable names for configuring video provider endpoints and keys.
# DO NOT commit real secrets. Use your hosting provider (Vercel) to set these for production.

# Runway (optional)
RUNWAY_ENDPOINT=https://api.runwayml.com/v1/video
RUNWAY_KEY=your_runway_api_key_here

# Pika
PIKA_ENDPOINT=https://your-pika-endpoint.example.com/generate
PIKA_KEY=your_pika_api_key_here

# Synthesia
SYNTHESIA_ENDPOINT=https://api.synthesia.io/v1/videos
SYNTHESIA_KEY=your_synthesia_api_key_here

# OpenAI Video (placeholder)
OPENAI_VIDEO_ENDPOINT=https://api.openai.com/v1/videos
OPENAI_VIDEO_KEY=your_openai_video_api_key_here

# Gemini (Google) - if you run a server-side proxy or endpoint for Gemini
GEMINI_ENDPOINT=https://your-gemini-proxy.example.com/generate
GEMINI_KEY=your_gemini_api_key_here

# Notes:
# - Set these variables in Vercel Project Settings → Environment Variables (Production/Preview/Development).
# - After changing or adding env vars, redeploy the project so they are available to serverless functions.
# - Never put real API keys in the repository. This file is only an example/template.
